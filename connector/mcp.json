{
  "mcpServers": {
    "yvonneyx-ava": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package=https://github.com/yvonneyx/ava-workbuddy/releases/download/v1.0.1/ava-workbuddy-1.0.1.tgz",
        "ava-workbuddy",
        "serve"
      ],
      "runtime": { "type": "node", "version": ">=22.13.0 <23" },
      "timeout": 120000,
      "x-workbuddy": {
        "displayName": { "zh": "AVA 本地分析工具", "en": "AVA Local Analysis" },
        "description": {
          "zh": "社区接入；本地计算，数据库和飞书需用户授权。暂不支持 HTTP 文件与 SSH 隧道。",
          "en": "Community integration for local analysis. Database and Feishu access require user authorization. HTTP file sources and SSH tunnels are disabled."
        },
        "icon": "./icon.svg",
        "auth": { "type": "none" }
      }
    }
  }
}
