{
  "mcpServers": {
    "ava-data-analysis": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package=https://github.com/yvonneyx/ava-workbuddy/releases/download/v1.0.1/ava-workbuddy-1.0.1.tgz",
        "ava-workbuddy",
        "serve"
      ],
      "runtime": { "type": "node", "version": ">=22.13.0 <23" },
      "timeout": 120000,
      "x-workbuddy": {
        "displayName": { "zh": "AVA 本地分析工具", "en": "AVA Local Analysis" },
        "description": {
          "zh": "分析本地文件、数据库和飞书多维表格，探索数据、核对指标，生成交互图表和可追溯的分析报告。",
          "en": "Analyze local files, databases and Feishu/Lark Bitable with AVA. Explore data, verify metrics, and create interactive charts and traceable analysis reports."
        },
        "icon": "./icon.svg",
        "auth": { "type": "none" }
      }
    }
  }
}
